QMainWindow, QDialog {
    background-color: #f1f5f8;
    color: #182a3a;
}

QWidget#centralWidget {
    background-color: #f1f5f8;
}

QLabel {
    color: #526273;
    font-size: 13px;
}

QLabel#pageTitle {
    color: #173b4a;
    font-size: 23px;
    font-weight: 700;
    padding: 4px 0;
}

QLabel#sectionHeading {
    color: #214757;
    font-size: 16px;
    font-weight: 700;
}

QLabel#sectionNote {
    color: #728490;
    font-size: 11px;
}

QLineEdit, QComboBox, QDoubleSpinBox, QDateEdit {
    min-height: 35px;
    padding: 4px 10px;
    border: 1px solid #c8d4dc;
    border-radius: 6px;
    background-color: #ffffff;
    color: #182a3a;
    selection-background-color: #247f83;
    selection-color: #ffffff;
}

QLineEdit:hover, QComboBox:hover, QDoubleSpinBox:hover, QDateEdit:hover {
    border-color: #8ca5b2;
}

QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
    border: 2px solid #247f83;
    padding: 3px 9px;
}

QComboBox::drop-down, QDateEdit::drop-down {
    width: 28px;
    border: 0;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #182a3a;
    border: 1px solid #c8d4dc;
    border-radius: 6px;
    selection-background-color: #247f83;
    selection-color: #ffffff;
    outline: 0;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 4px 10px;
    color: #182a3a;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #e9f3f2;
    color: #155e63;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #247f83;
    color: #ffffff;
}

QPushButton {
    min-height: 34px;
    padding: 5px 12px;
    border: 1px solid #cbd6dc;
    border-radius: 6px;
    background-color: #ffffff;
    color: #294557;
    font-weight: 600;
}

QPushButton:hover {
    border-color: #247f83;
    background-color: #e9f3f2;
    color: #155e63;
}

QPushButton:pressed {
    background-color: #d5e9e7;
}

QPushButton:disabled {
    border-color: #d9e0e4;
    background-color: #edf0f2;
    color: #98a4ad;
}

QPushButton#primaryAction {
    border-color: #247f83;
    background-color: #247f83;
    color: #ffffff;
}

QPushButton#primaryAction:hover {
    border-color: #19686c;
    background-color: #19686c;
}

QPushButton#dangerAction {
    border-color: #c65e52;
    background-color: #c65e52;
    color: #ffffff;
}

QPushButton#dangerAction:hover {
    border-color: #a9473d;
    background-color: #a9473d;
}

QPushButton#exportAction {
    border-color: #386ea5;
    background-color: #386ea5;
    color: #ffffff;
}

QPushButton#exportAction:hover {
    border-color: #2b5988;
    background-color: #2b5988;
}

QPushButton#helpAction {
    border-color: #d1a344;
    background-color: #fff8e7;
    color: #785915;
}

QTableWidget {
    gridline-color: #e7edf0;
    border: 1px solid #d6e0e5;
    border-radius: 7px;
    background-color: #ffffff;
    alternate-background-color: #f7f9fa;
    selection-background-color: #dceceb;
    selection-color: #173b4a;
}

QTableWidget::item {
    padding: 7px 8px;
    border-bottom: 1px solid #edf1f3;
}

QTableWidget::item:selected {
    background-color: #dceceb;
    color: #173b4a;
}

QHeaderView::section {
    min-height: 36px;
    padding: 5px 8px;
    border: 0;
    border-bottom: 2px solid #48a6a0;
    background-color: #214757;
    color: #ffffff;
    font-weight: 700;
}

QFrame#statCard {
    min-height: 78px;
    border: 1px solid #d6e0e5;
    border-left: 5px solid #247f83;
    border-radius: 7px;
    background-color: #ffffff;
}

QFrame#statCard[accent="green"] {
    border-left-color: #38a27f;
}

QFrame#statCard[accent="coral"] {
    border-left-color: #e17461;
}

QFrame#statCard[accent="blue"] {
    border-left-color: #4d8fc2;
}

QLabel#statLabel {
    color: #657686;
    font-size: 12px;
}

QLabel#statValue {
    color: #193f50;
    font-size: 20px;
    font-weight: 700;
}

QChartView {
    min-height: 235px;
    border: 1px solid #d6e0e5;
    border-radius: 7px;
    background-color: #ffffff;
}

QDialog QPushButton {
    min-width: 105px;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* Lisibilité dans tous les dialogs */
QDialog QLabel {
    color: #182a3a;
    font-size: 13px;
}

QDialog QLineEdit,
QDialog QComboBox,
QDialog QDoubleSpinBox,
QDialog QDateEdit,
QDialog QSpinBox {
    color: #182a3a;
    background-color: #ffffff;
    border: 1px solid #c8d4dc;
    border-radius: 6px;
    min-height: 34px;
    padding: 4px 10px;
}

QDialog QLineEdit:focus,
QDialog QComboBox:focus,
QDialog QDoubleSpinBox:focus,
QDialog QDateEdit:focus {
    border: 2px solid #247f83;
}

QDialog QCheckBox {
    color: #182a3a;
    font-size: 13px;
    spacing: 8px;
}

QDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #b0bec5;
    border-radius: 3px;
    background-color: #ffffff;
}

QDialog QCheckBox::indicator:checked {
    background-color: #247f83;
    border-color: #247f83;
}

QDialog QGroupBox {
    color: #182a3a;
    font-weight: 700;
    border: 1px solid #c8d4dc;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 10px;
}

QDialog QGroupBox::title {
    subcontrol-origin: margin;
    padding: 0 6px;
    color: #214757;
}

QTextBrowser#userGuideView {
    background-color: #ffffff;
    color: #182a3a;
    border: 1px solid #d6e0e5;
    border-radius: 7px;
    padding: 12px;
    font-size: 13px;
}

QFrame#sidebar {
    background-color: #173b4a;
    border-right: 1px solid #2b5363;
}

QLabel#sidebarBrand {
    color: #ffffff;
    font-size: 25px;
    font-weight: 700;
    padding: 3px 9px 0;
}

QLabel#sidebarSubtitle {
    color: #a7c0ca;
    font-size: 10px;
    font-weight: 700;
    padding: 0 10px;
}

QLabel#sidebarSection {
    color: #92b2bf;
    font-size: 10px;
    font-weight: 700;
    padding: 0 10px 3px;
}

QPushButton#sidebarNavButton {
    min-height: 40px;
    padding: 7px 11px;
    border: 1px solid transparent;
    border-radius: 6px;
    background-color: transparent;
    color: #dce7eb;
    font-weight: 500;
    text-align: left;
}

QPushButton#sidebarNavButton:hover {
    border-color: #315f70;
    background-color: #214b5c;
    color: #ffffff;
}

QPushButton#sidebarNavButton:checked {
    border-color: #347dab;
    border-left: 4px solid #8ed0bf;
    background-color: #347dab;
    color: #ffffff;
    padding-left: 8px;
}

QLabel#sidebarSchool {
    padding: 12px 10px 4px;
    border-top: 1px solid #315563;
    color: #dce7eb;
    font-size: 11px;
    font-weight: 600;
}

QScrollArea#dashboardScroll {
    border: 0;
    background-color: #f1f5f8;
}

QWidget#dashboardContent {
    background-color: #f1f5f8;
}

QFrame#statCard[accent="green"] {
    border-color: #cee5dc;
    border-left-color: #38a27f;
    background-color: #eaf5f0;
}

QFrame#statCard[accent="coral"] {
    border-color: #f0d7d2;
    border-left-color: #e17461;
    background-color: #fff0ed;
}

QFrame#statCard[accent="blue"] {
    border-color: #d3e1ee;
    border-left-color: #4d8fc2;
    background-color: #edf4fa;
}

QScrollBar:vertical {
    width: 10px;
    margin: 2px;
    border: 0;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 28px;
    border-radius: 4px;
    background: #b8c8d0;
}

QScrollBar::handle:vertical:hover {
    background: #829ca9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
